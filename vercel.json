  "outputDirectory": "dist",
  "functions": {
    "api/capture.mjs": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,api/fonts/**}"
    }
  }
}
